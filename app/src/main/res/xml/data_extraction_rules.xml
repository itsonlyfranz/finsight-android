<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Models are re-downloadable; secrets are bound to this device's Keystore and unusable elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="finsight_secrets.xml" />
        <exclude domain="sharedpref" path="finsight_models.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="finsight_secrets.xml" />
        <exclude domain="sharedpref" path="finsight_models.xml" />
    </device-transfer>
</data-extraction-rules>
