<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Downloaded models are huge and re-downloadable; encrypted secrets are bound to this device's Keystore. -->
<full-backup-content>
    <exclude domain="file" path="models/" />
    <exclude domain="sharedpref" path="finsight_secrets.xml" />
    <exclude domain="sharedpref" path="finsight_models.xml" />
</full-backup-content>
